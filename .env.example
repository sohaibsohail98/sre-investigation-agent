# Copy to .env (gitignored) if you want to override defaults locally.
# None of these are secrets — auth is via your AWS credentials
# (aws configure / SSO), not env vars, so there's nothing sensitive here.

# Which Bedrock model the agent calls. Must keep the "us." inference-profile
# prefix — the bare model ID is rejected by converse() with a
# ValidationException (see docs/PROJECT.md's "AWS/Bedrock gotchas" section
# if you hit this).
MODEL_ID=us.anthropic.claude-sonnet-4-6

# AWS region — must be one where you have Bedrock model access granted.
AWS_REGION=us-east-1

# Max tool-calling turns per investigation before the loop gives up.
# Raised 6->10, then 10->15 — the same "hit the limit on a multi-signal
# investigation" reason both times — see docs/PROJECT.md's History section.
MAX_TURNS=15

# "sqlite" (default, local dev) or "dynamodb" (set automatically by
# Terraform on the deployed AgentCore runtime — don't set this by hand
# unless you're pointing local tools at the deployed table on purpose).
STORAGE_BACKEND=sqlite

# Only read when STORAGE_BACKEND=dynamodb.
METRICS_TABLE=sre-agent-metrics
